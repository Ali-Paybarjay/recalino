{
  "name": "recalino",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tools",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "check:boundaries": "depcruise apps packages tools --config .dependency-cruiser.cjs --output-type err",
    "db:types": "node tools/db-types.mjs",
    "db:env": "node tools/local-env.ts",
    "dev": "pnpm --filter @recalino/web dev",
    "build": "pnpm --filter @recalino/web build",
    "test:e2e": "pnpm --filter @recalino/web test:e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test",
    "check:client-bundle": "node tools/client-bundle/check.ts",
    "legal:build": "node tools/legal/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.0",
    "dependency-cruiser": "18.4.0",
    "kysely": "0.29.6",
    "kysely-codegen": "0.20.0",
    "pg": "8.23.1",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
