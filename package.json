{
  "name": "recalino",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
