{
  "name": "@recalino/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node --conditions=react-server ../../tools/voice/prepare-build.mjs && node tools/check-native-runtime.mjs && next build --webpack && node tools/trace-native-dependencies.mjs && node tools/trace-voice-native.mjs",
