  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__Supabase__execute_sql|mcp__claude_ai_Supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/data-loss-guard.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
