# Copy to apps/web/.env.local for local development; `pnpm db:env` writes the local stack's values.
# Names only: never commit real values (PROJECT_SPEC §8).
# Every name here is server-only; the build check fails if one appears in browser code (FR-PLT-009).

# Server-side Postgres connection as the recalino_app role (ADR-0002).
# Local default after `pnpm db:start`: see packages/core/test/local-db.ts.
# Visible ASCII only and no query parameters: the app sets TLS itself and verifies the server
# against the Supabase CA (packages/core/src/db/connection.ts). Only a loopback host is plain.
# Cloud value: `pnpm db:new-password`, then `pnpm db:url-check` (docs/runbooks/SECRETS.md).
DATABASE_URL=

# At least 32 random characters; keys the hash of client IPs for rate limiting (FR-PLT-006).
RATE_LIMIT_IP_KEY=

# Optional JSON overriding the PLT defaults (packages/core/src/plt/settings.ts).
PLT_SETTINGS_JSON=

# At least 32 random characters. Vercel Cron sends it as a bearer token to the job runner,
# /api/jobs/run (FR-PLT-005, M4). Locally the runner is only called by tests.
CRON_SECRET=

# Set to 1 only in the CI end-to-end job: serves the /dev UI test pages in a production build.
RECALINO_DEV_UI=

# Supabase Auth, server side only (M3, FR-PLT-001). `pnpm db:env` fills these for the local stack.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key: deletes an Auth user left without a Recalino account (FR-ACC-001). Never in the browser.
SUPABASE_SECRET_KEY=

# Optional JSON overriding the ACC defaults (packages/core/src/acc/settings.ts), e.g. the languages
# that passed the quality check (D31).
ACC_SETTINGS_JSON=

# The pilot operator's address and name for the legal texts and "Ask the pilot operator"
# (docs/legal/README.md, FR-QUOTA). Server configuration only; never written in the repository.
PILOT_OPERATOR_EMAIL=
PILOT_OPERATOR_NAME=

# For the Supabase CLI, in the root .env (not here): Google sign-in for local development
# (docs/runbooks/GOOGLE_OAUTH.md). The app never reads them.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# AI and export configuration is server-only. JSON examples live in config/.
# The default AI contract flag is false until operator approval; no implicit quota is granted.
OPENROUTER_API_KEY=
OPENROUTER_SETTINGS_JSON=
RECALINO_EXPORT_SETTINGS_JSON=
RECALINO_MEDIA_SETTINGS_JSON=
PDF_RENDER_SETTINGS_JSON=
# Operator encryption key; preserve securely outside the database for restore.
RECALINO_BACKUP_KEY_ID=
RECALINO_BACKUP_KEY_BASE64=
# Optional JSON overriding backup retention (packages/core/src/ops/backups.ts, OPS-01): keepReady
# newest ready backups survive the 30-day expiry; staleAfterHours raises the stale-backup alert.
RECALINO_BACKUP_RETENTION_JSON=

# Approved admin/support email outbox (D41/D42). Gmail is temporary for the pilot.
# Never commit an App Password; store it as a Sensitive Production variable in Vercel.
# RECALINO_EMAIL_PROVIDER: gmail or resend (absent defaults to resend).
RECALINO_EMAIL_PROVIDER=
RECALINO_EMAIL_FROM=
RECALINO_EMAIL_REPLY_TO=
RECALINO_PUBLIC_APP_URL=

# Optional opt-in completion alerts. Generate once with: node tools/web-push/configure-local.mjs
# Keep the private key server-only; use a real HTTPS contact URL or mailto address in production.
RECALINO_WEB_PUSH_PUBLIC_KEY=
RECALINO_WEB_PUSH_PRIVATE_KEY=
RECALINO_WEB_PUSH_SUBJECT=
RECALINO_GMAIL_USER=
RECALINO_GMAIL_APP_PASSWORD=
RESEND_API_KEY=

# Storage (Vercel Blob, FR-PLT-014, ADR-0001). A private store in lhr1; absent locally, where no
# feature needs files. Either name connects it: BLOB_STORE_ID with OIDC on Vercel, or the token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Voice engine (workstream 4, D54/D64). Weights are provisioned at build time (tools/voice) and
# traced into the Function; the paths are for an operator-managed install and must be absolute.
# Optional JSON overriding the voice switches (packages/core/src/voc/settings.ts).
VOICE_SETTINGS_JSON=
VOICE_SEGMENTATION_MODEL_PATH=
VOICE_EMBEDDING_MODEL_PATH=
# Build only: set to 1 to download the pinned weights outside Vercel (Vercel sets VERCEL=1 itself).
RECALINO_PROVISION_VOICE_MODELS=

# Capture switches (D60, D61). Each is on by default; the value off is the kill switch.
# D60: sealed recording parts are uploaded during the class instead of after Stop.
RECALINO_CAPTURE_EARLY_UPLOAD=
# D61: staged parts are transcribed in the background instead of at the class run.
RECALINO_CAPTURE_EARLY_TRANSCRIPTION=
# Technical capture events (no audio, text or ids, PRD-PRIV-06); off accepts and discards them.
RECALINO_CAPTURE_DIAGNOSTICS=

# Preview/dev only. Never set in production.
# Set to 1: serves /preview with synthetic data and no back end (ignored when VERCEL_ENV is production).
RECALINO_UI_PREVIEW=

# Build only: the web build stops when a traced Function is larger than this many MB (default 225;
# Vercel refuses 250). See tools/function-size and docs/PROJECT_SPEC.md.
RECALINO_FUNCTION_SIZE_LIMIT_MB=
