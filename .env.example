# Copy to apps/web/.env.local for local development; `pnpm db:env` writes the local stack's values.
# Names only: never commit real values (PROJECT_SPEC §8).
# Every name here is server-only; the build check fails if one appears in browser code (FR-PLT-009).

# Server-side Postgres connection as the recalino_app role (ADR-0002).
# Local default after `pnpm db:start`: see packages/core/test/local-db.ts.
# Visible ASCII only and no query parameters: the app sets TLS itself and verifies the server
# against the Supabase CA (packages/core/src/db/connection.ts). Only a loopback host is plain.
# Cloud value: `pnpm db:new-password`, then `pnpm db:url-check` (docs/runbooks/SECRETS.md).
DATABASE_URL=

# At least 32 random characters; keys the hash of client IPs for rate limiting (FR-PLT-006).
RATE_LIMIT_IP_KEY=

# Optional JSON overriding the PLT defaults (packages/core/src/plt/settings.ts).
PLT_SETTINGS_JSON=

# At least 32 random characters. Vercel Cron sends it as a bearer token to the job runner,
# /api/jobs/run (FR-PLT-005, M4). Locally the runner is only called by tests.
CRON_SECRET=

# Set to 1 only in the CI end-to-end job: serves the /dev UI test pages in a production build.
RECALINO_DEV_UI=

# Supabase Auth, server side only (M3, FR-PLT-001). `pnpm db:env` fills these for the local stack.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key: deletes an Auth user left without a Recalino account (FR-ACC-001). Never in the browser.
SUPABASE_SECRET_KEY=

# Optional JSON overriding the ACC defaults (packages/core/src/acc/settings.ts), e.g. the languages
# that passed the quality check (D31).
ACC_SETTINGS_JSON=

# The pilot operator's address and name for the legal texts and "Ask the pilot operator"
# (docs/legal/README.md, FR-QUOTA). Server configuration only; never written in the repository.
PILOT_OPERATOR_EMAIL=
PILOT_OPERATOR_NAME=

# For the Supabase CLI, in the root .env (not here): Google sign-in for local development
# (docs/runbooks/GOOGLE_OAUTH.md). The app never reads them.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# AI and export configuration is server-only. JSON examples live in config/.
# The default AI contract flag is false until operator approval; no implicit quota is granted.
OPENROUTER_API_KEY=
OPENROUTER_SETTINGS_JSON=
RECALINO_EXPORT_SETTINGS_JSON=
RECALINO_MEDIA_SETTINGS_JSON=
PDF_RENDER_SETTINGS_JSON=
# Operator encryption key; preserve securely outside the database for restore.
RECALINO_BACKUP_KEY_ID=
RECALINO_BACKUP_KEY_BASE64=
