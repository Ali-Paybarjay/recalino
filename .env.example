# Copy to .env.local for local development. Names only: never commit real values (PROJECT_SPEC §8).
# Every name here is server-only; the build check fails if one appears in browser code (FR-PLT-009).

# Server-side Postgres connection as the recalino_app role (ADR-0002).
# Local default after `pnpm db:start`: see packages/core/test/local-db.ts.
DATABASE_URL=

# At least 32 random characters; keys the hash of client IPs for rate limiting (FR-PLT-006).
RATE_LIMIT_IP_KEY=

# Optional JSON overriding the PLT defaults (packages/core/src/plt/settings.ts).
PLT_SETTINGS_JSON=

# Set to 1 only in the CI end-to-end job: serves the /dev UI test pages in a production build.
RECALINO_DEV_UI=
